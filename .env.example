# ChemSurplus backend env (set these in your Vercel project → Settings → Environment Variables).
# All are optional — the API runs without them (email no-ops, storage is in-memory).

# --- Email (so RFQs actually send) ---
# Get a free key at resend.com. Until you verify a domain, use the test sender below.
RESEND_API_KEY=
RFQ_FROM=ChemSurplus <onboarding@resend.dev>
# Where RFQ notifications land (your inbox). If unset, falls back to the buyer's own email.
RFQ_INBOX=

# --- Persistence (so listings/RFQs survive) ---
# Create a Vercel KV store and link it; Vercel injects these automatically.
KV_REST_API_URL=
KV_REST_API_TOKEN=
